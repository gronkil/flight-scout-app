{
  "name": "flight-scout-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Aplikacja mobilna flight-scout (Expo / React Native). Rozmawia TYLKO z naszym API.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "build": "expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.2",
    "expo-device": "~6.0.2",
    "expo-notifications": "~0.28.19",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1"
  },
  "devDependencies": {
    "@types/react": "~18.2.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
