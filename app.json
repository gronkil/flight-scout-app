{
  "expo": {
    "name": "Odlot",
    "slug": "flight-scout",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "flightscout",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#141B2E"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android": {
      "package": "com.flightscout.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#FF5A5F"
      }
    },
    "plugins": ["expo-notifications"],
    "extra": {
      "apiBaseUrl": "https://flight-scout-api.onrender.com",
      "google": {
        "androidClientId": "",
        "webClientId": ""
      },
      "eas": {
        "projectId": "92472aec-66ca-458b-a9e5-98409f66e08e"
      }
    }
  }
}
