{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull origin dev)",
      "Bash(git checkout dev)",
      "Bash(git checkout -B dev:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin dev)",
      "Bash(git push origin dev)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest run)",
      "mcp__github__actions_list",
      "mcp__github__get_job_logs",
      "mcp__github__get_commit",
      "mcp__github__list_commits",
      "mcp__github__list_releases",
      "mcp__github__get_release_by_tag",
      "mcp__github__get_latest_release",
      "mcp__github__get_check_run",
      "mcp__github__pull_request_read",
      "mcp__github__get_me",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__Claude_Code_Remote__list_triggers"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push:* main)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)"
    ]
  }
}
